# Firebase configuration
# Copy this file to .env.local and fill in your Firebase project values.
# You can find these in the Firebase Console under Project Settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Search relevance ranking (optional)
# URL of the deployed Cloudflare Worker that proxies to TypeSafe (see worker/).
# Leave blank to use substring-only search with no semantic ranking.
NEXT_PUBLIC_SEARCH_RANK_URL=
